# ------------------------------------------------------------
# Secrets (do NOT commit)
# ------------------------------------------------------------
# Local environment overrides
.env
.env.*

# Firebase Functions local runtime config (contains secrets)
functions/.runtimeconfig.json

# Firebase Admin / Service Account keys (private keys)
**/*serviceAccount*.json
**/*ServiceAccount*.json
**/*firebase-adminsdk*.json
**/*FirebaseAdminSdk*.json

# Firebase Client Configuration (contains API keys)
# Note: These are client-side keys (not secret), but best practice is to not commit them
android/app/google-services.json
ios/**/GoogleService-Info.plist
firebase-config.js

# fastlane
#
# It is recommended to not store the screenshots in the git repo. Instead, use fastlane to re-generate the
# screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/

**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# Bundle artifact
*.jsbundle

# Ruby / CocoaPods
**/Pods/
/vendor/bundle/

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# testing
/coverage

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.git.backup
