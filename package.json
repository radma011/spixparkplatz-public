{
  "name": "spixparkplatz",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:device": "react-native run-android --deviceId",
    "android:apk": "cd android && ./gradlew assembleRelease && cd .. && cp android/app/build/outputs/apk/release/app-release.apk download-page/SpixParkplatz.apk",
    "download-page:version": "node scripts/write-version-json.js",
    "ios": "react-native run-ios",
    "ios:device": "react-native run-ios --device",
    "ios:minimanolito": "./scripts/run-ios-device.sh \"Minimanolito 7\"",
    "ios:list": "xcrun simctl list devices",
    "ios:simulators": "./scripts/list-simulators.sh",
    "ios:screenshots": "./scripts/take-screenshots.sh",
    "ios:resize-screenshots": "./scripts/resize-screenshots.sh",
    "android:list": "adb devices",
    "lint": "eslint .",
    "start": "react-native start --host 0.0.0.0",
    "web": "webpack serve --config webpack.config.js",
    "web:build": "npm run favicon && WEB_BASE_PATH=/apps/spixparkplatz webpack --config webpack.config.js --mode production",
    "web:build:root": "npm run favicon && webpack --config webpack.config.js --mode production",
    "favicon": "node scripts/generate-favicon.js",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.24.0",
    "@react-native-community/datetimepicker": "^8.5.1",
    "@react-native-firebase/app": "^23.7.0",
    "@react-native-firebase/auth": "^23.7.0",
    "@react-native-firebase/firestore": "^23.7.0",
    "@react-native-firebase/functions": "^23.7.0",
    "@react-native-firebase/messaging": "^23.7.0",
    "@react-native/new-app-screen": "0.83.1",
    "firebase": "^12.9.0",
    "react": "19.2.0",
    "react-native": "^0.83.1",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-svg": "^15.15.1",
    "react-native-vector-icons": "^10.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-flow-strip-types": "^7.27.1",
    "@babel/preset-env": "^7.25.3",
    "@babel/preset-react": "^7.28.5",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.83.1",
    "@react-native/eslint-config": "0.83.1",
    "@react-native/metro-config": "0.83.1",
    "@react-native/typescript-config": "0.83.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.3",
    "@types/react-test-renderer": "^19.1.0",
    "ajv": "^8.18.0",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^13.0.1",
    "eslint": "^8.19.0",
    "html-webpack-plugin": "^5.6.6",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-dom": "^19.2.0",
    "react-native-web": "^0.21.2",
    "react-test-renderer": "19.2.0",
    "sharp": "^0.34.5",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.105.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.3"
  },
  "engines": {
    "node": ">=20"
  }
}
